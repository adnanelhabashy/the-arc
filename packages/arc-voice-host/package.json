{
  "name": "bb-arc-voice-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Arc Voice host runtime: the Voicebox process, client, and service Arc's plugin host workers own.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "semver": "^7.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
